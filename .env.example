# Copy to .env.local (gitignored) and fill in. Never commit real values.

# ElevenLabs: a dedicated "pokta-clinic" key, restricted to Agents, with a credit limit.
ELEVENLABS_API_KEY=

# Render: account API key for the CLI (pnpm render). The EHR on/off toggle uses its own copy in Vercel (RENDER_API_KEY, see docs/deploy.md); it is account-wide, treat it as high risk.
RENDER_API_KEY=

# apps/web origin the agent tools call (pnpm agent:build). Not a secret.
POKTA_WEB_URL=

# apps/web calendar (Vercel env vars, set with `vercel env add`, see docs/deploy.md). Local dev uses CALENDAR_PROVIDER=fake in apps/web/.env.local.
CALENDAR_PROVIDER=
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_CALENDAR_ID_GMA_DEL_VALLE=
GOOGLE_CALENDAR_ID_GMA_POLANCO=
GOOGLE_CALENDAR_ID_GMA_SATELITE=

# apps/web live page, store, outbox, toggle and webhook (Vercel env vars, see docs/deploy.md and apps/web/.env.example).
STORE_PROVIDER=
KV_REST_API_URL=
KV_REST_API_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
RENDER_EHR_SERVICE_ID=
RENDER_EHR_POSTGRES_ID=
ELEVENLABS_WEBHOOK_SECRET=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
