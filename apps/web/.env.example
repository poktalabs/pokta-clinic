# Copy to .env.local for local dev. Production values live in Vercel's environment.
EHR_BASE_URL=http://localhost:8787
EHR_CLIENT_ID=pokta-clinic
EHR_CLIENT_SECRET=
# Shared with the ElevenLabs workspace Secret `tool_secret`; sent in the x-pokta-tool-secret header.
TOOL_SECRET=
# Calendar: "google" (default, needs the two vars below) or "fake" (in memory, local dev only).
CALENDAR_PROVIDER=fake
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_CALENDAR_ID=
