# Copy to .env.local for local dev. Production values live in Vercel's environment.
EHR_BASE_URL=http://localhost:8787
EHR_CLIENT_ID=pokta-clinic
EHR_CLIENT_SECRET=
# Shared with the ElevenLabs workspace Secret `tool_secret`; sent in the x-pokta-tool-secret header.
TOOL_SECRET=
# Calendar: "google" (default, needs the key and the three calendar ids below, one calendar per branch) or "fake" (in memory, local dev only).
CALENDAR_PROVIDER=fake
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_CALENDAR_ID_GMA_DEL_VALLE=
GOOGLE_CALENDAR_ID_GMA_POLANCO=
GOOGLE_CALENDAR_ID_GMA_SATELITE=

# Store: "upstash" (default; needs the REST pair below, injected by the Vercel Marketplace integration,
# which may name it UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead) or "memory" (local dev and tests only).
STORE_PROVIDER=memory
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Admin login (EHR toggle, outbox drain, conversation records) and the cron bearer token.
ADMIN_PASSWORD=
# Optional: signs the admin cookie; defaults to a key derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
CRON_SECRET=
# EHR on/off toggle through the Render API. The key is account-wide: see docs/deploy.md.
RENDER_API_KEY=
RENDER_EHR_SERVICE_ID=
RENDER_EHR_POSTGRES_ID=
# Post-call webhook signing secret from ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=
# Public by design: the agent id of the widget on the home page.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
